{
  "name": "markdown2pdf-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Markdown2PDF — Markdown to PDF editor for Windows",
  "author": "Pragmatic Disruptor, LLC.",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"wait-on http://127.0.0.1:5174 && cross-env M2PDF_ELECTRON_DEV=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win --x64",
    "pack:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@m2pdf/core": "0.1.0",
    "dompurify": "^3.2.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "postcss": "^8.4.49",
    "rcedit": "^4.0.1",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.pragmaticdisruptor.markdown2pdf",
    "productName": "Markdown2PDF",
    "copyright": "Copyright © Pragmatic Disruptor, LLC.",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "afterPack": "./scripts/afterPack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "role": "Editor"
        },
        {
          "ext": "markdown",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markdown2PDF",
      "license": "build/license.txt"
    }
  }
}
