{
  "name": "markdown2pdf",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown → PDF Editor by Pragmatic Disruptor, LLC. — preview and print-to-PDF (Edge-first)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "dev:desktop": "npm run dev -w markdown2pdf-desktop",
    "build:desktop": "npm run build -w markdown2pdf-desktop",
    "pack:desktop": "npm run pack -w markdown2pdf-desktop"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "markdown-it": "^14.1.0",
    "markdown-it-multimd-table": "^4.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
